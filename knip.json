{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{mjs,ts}"
      ],
      "project": [
        "scripts/**"
      ]
    },
    "packages/*": {
      "entry": [
        "src/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "e2e": {
      "entry": [
        "src/**/*.specs.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
